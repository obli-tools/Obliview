# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIVIEW_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obliview:yourpassword@your-db-host:5432/obliview

# ── Server ──
PORT=3001
NODE_ENV=production
# Signs the session cookies. REQUIRED: a random value of 32+ characters,
# e.g. `openssl rand -hex 32` (install.sh generates one). In production the
# server logs a SECURITY error at every boot while it is unset, shorter than
# 32 chars or a placeholder from this repository (cookies would be forgeable).
# Changing it signs everyone out. While ENCRYPTION_KEY is unset it is ALSO the
# key of the stored SSH remediation credentials: when rotating it, either set
# ENCRYPTION_KEY to the OLD SESSION_SECRET value, or set SESSION_SECRET_PREVIOUS
# to it until every SSH action has run once (credentials are then re-encrypted
# with the new key) — otherwise they can no longer be decrypted.
SESSION_SECRET=change-this-to-a-random-secret
# Optional. When set, same 32+ character rule as SESSION_SECRET; key of the
# stored SSH remediation credentials (instead of SESSION_SECRET).
# ENCRYPTION_KEY=
# Optional, only during a rotation: previous values still accepted to read
# stored SSH credentials (they are re-encrypted with the current key on use).
# SESSION_SECRET_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS=

# ── Obligate SSO (optional) ──
# Secret Obligate must present (Bearer) on its server-to-server calls to this
# instance (user sync pushes...). Overrides the inbound secret configured in
# Settings > Obligate. Leave empty to use the Settings value / the API key.
# OBLIGATE_INBOUND_SECRET=

# ── Remediations ──
# Remediation actions that execute on or from this server (script, ssh,
# docker_restart). Enabled when unset; only the exact value "false" disables
# them. Even when enabled, only a platform admin can create or edit them.
# REMEDIATION_ALLOW_SERVER_SCRIPTS=true

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
# LISTEN_PORT=3000

# ── HTTPS deployments (recommended if served behind an HTTPS reverse proxy) ──
# Always marks the session cookie Secure (it is SameSite=Lax in every mode).
# Leave unset (or =false) for plain-HTTP / local dev deployments.
# (With NODE_ENV=production the session cookie is marked Secure anyway
# whenever the request reached the server over HTTPS.)
# FORCE_HTTPS=true

# ── App name (used as prefix in notification messages) ──
APP_NAME=Obliview

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Monitor limits (admin policy) ──
# Minimum allowed check interval in seconds (default: 10)
# MIN_CHECK_INTERVAL=10
# Minimum allowed retry interval in seconds (default: 5)
# MIN_RETRY_INTERVAL=5

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliview/custom
# CUSTOM_DIR=./custom

# ── Agent updates ──
# Agents no longer self-update: admins start paced rollouts from the UI.
# true = old behaviour (agents update themselves on every push).
# AGENT_LEGACY_AUTO_UPDATE=false
# Rollout pace: at most N updates handed out per window (fleet-wide).
# AGENT_UPDATE_ROLLOUT_MAX_PER_WINDOW=25
# AGENT_UPDATE_ROLLOUT_WINDOW_SECONDS=60

# ── Emergency switch: ignore the "Force 2FA" setting ──
# DISABLE_2FA_FORCE=true
